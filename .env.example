PORT=5000
NODE_ENV=development
SITE_NAME="Shaadi Undo"

# MongoDB
MONGO_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/shadi-undo?retryWrites=true&w=majority"
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Shaadi Undo <support@shaadiundo.com>
RESEND_API_KEY=your_resend_api_key

# Twilio (SMS/Verify)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Daily.co
DAILY_API_KEY=your_daily_api_key
DAILY_DOMAIN=shaadiundo.daily.co
DAILY_DOMAIN_ID=your_daily_domain_id
DAILY_WEBHOOK_SECRET=your_daily_webhook_secret

# Google Cloud Storage (Recordings)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
RECORDING_BUCKET=shaadiundo-recordings

# Admin Init
INIT_ADMIN_SECRET=your_init_admin_secret
